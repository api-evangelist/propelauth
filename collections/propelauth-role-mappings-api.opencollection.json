{
  "opencollection": "1.0.0",
  "info": {
    "name": "PropelAuth End-User API Keys Access Tokens Role Mappings API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Role Mappings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Role Mappings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{authId}.propelauthtest.com/api/backend/v1/custom_role_mappings"
          },
          "docs": "List custom role mappings configured for your project."
        }
      ]
    }
  ],
  "bundled": true
}