  "info": {
    "_postman_id": "71668c93-a1b1-4fa4-88e8-dc137a5c327b",
    "name": "PropelAuth End-User API Keys Access Tokens Dynamic Client Registration API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Backend REST API for validating, issuing, listing, and revoking API keys that PropelAuth\nmanages on behalf of your end users and tenant organizations. API keys can be scoped to a\npersonal user, an organization, or imported from a legacy auth system. All endpoints\nrequire a PropelAuth Backend Integration API key.\n\n\nContact Support:\n Name: PropelAuth Support\n Email: support@propelauth.com",
      "type": "text/plain"
    }
  }
