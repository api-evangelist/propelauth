{
  "opencollection": "1.0.0",
  "info": {
    "name": "PropelAuth End-User Access Tokens API Keys API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Active API Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{authId}.propelauthtest.com/api/backend/v1/end_user_api_keys",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_number",
                "value": "",
                "type": "query"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "org_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "user_email",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Page through active API keys for your project."
        },
        {
          "info": {
            "name": "Create API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{authId}.propelauthtest.com/api/backend/v1/end_user_api_keys",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new API key bound to a user, organization, or both."
        },
        {
          "info": {
            "name": "Fetch API Key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{authId}.propelauthtest.com/api/backend/v1/end_user_api_keys/:apiKeyId",
            "params": [
              {
                "name": "apiKeyId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return the metadata for a single API key. The plaintext token is never returned."
        },
        {
          "info": {
            "name": "Update API Key",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{authId}.propelauthtest.com/api/backend/v1/end_user_api_keys/:apiKeyId",
            "params": [
              {
                "name": "apiKeyId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update mutable fields on an API key (metadata, expiration, etc.)."
        },
        {
          "info": {
            "name": "Delete API Key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{authId}.propelauthtest.com/api/backend/v1/end_user_api_keys/:apiKeyId",
            "params": [
              {
                "name": "apiKeyId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Revoke an API key. Subsequent validations of the token will fail."
        },
        {
          "info": {
            "name": "Fetch Expired API Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{authId}.propelauthtest.com/api/backend/v1/end_user_api_keys/archived",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_number",
                "value": "",
                "type": "query"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "org_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Page through expired and revoked API keys."
        },
        {
          "info": {
            "name": "Import API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{authId}.propelauthtest.com/api/backend/v1/end_user_api_keys/import",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Import an existing API key generated by a legacy auth system."
        }
      ]
    }
  ],
  "bundled": true
}