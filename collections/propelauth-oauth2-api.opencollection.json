{
  "opencollection": "1.0.0",
  "info": {
    "name": "PropelAuth OAuth2 API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "OAuth2",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authorize",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://auth.example.com/propelauth/oauth/authorize",
            "params": [
              {
                "name": "response_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "client_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "redirect_uri",
                "value": "",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              },
              {
                "name": "code_challenge",
                "value": "",
                "type": "query"
              },
              {
                "name": "code_challenge_method",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Redirect the user-agent to the PropelAuth login page. After successful login PropelAuth\nredirects back to your `redirect_uri` with a `code` parameter that you exchange at the\ntoken endpoint.\n"
        },
        {
          "info": {
            "name": "Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://auth.example.com/propelauth/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "code",
                  "value": ""
                },
                {
                  "name": "redirect_uri",
                  "value": ""
                },
                {
                  "name": "refresh_token",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "code_verifier",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Exchange an authorization code for an access token and refresh token, or exchange an\nexisting refresh token for a fresh access token.\n"
        },
        {
          "info": {
            "name": "User Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://auth.example.com/propelauth/oauth/userinfo",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return the OIDC user info document for the bearer token."
        },
        {
          "info": {
            "name": "Logout",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://auth.example.com/api/backend/v1/logout",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Invalidate the supplied refresh token. Backend-only."
        }
      ]
    },
    {
      "info": {
        "name": "Discovery",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenID Connect Discovery",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://auth.example.com/.well-known/openid-configuration"
          },
          "docs": "OpenID Connect discovery document for your PropelAuth Auth URL."
        }
      ]
    }
  ],
  "bundled": true
}