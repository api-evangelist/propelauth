{
  "opencollection": "1.0.0",
  "info": {
    "name": "PropelAuth End-User API Keys Access Tokens Validation API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Validation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Validate API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{authId}.propelauthtest.com/api/backend/v1/end_user_api_keys/validate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Validate an end-user API key and return the associated user, organization, and metadata.\nUse this endpoint at your API gateway / middleware layer to gate requests.\n"
        },
        {
          "info": {
            "name": "Validate Imported API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{authId}.propelauthtest.com/api/backend/v1/end_user_api_keys/validate_imported",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Validate an API key previously imported from an external auth system."
        }
      ]
    }
  ],
  "bundled": true
}